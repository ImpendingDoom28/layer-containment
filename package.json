{
  "name": "containment-layer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/dist/main.js",
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:stress": "vite --config stress/vite.config.ts",
    "build:stress": "vite build --config stress/vite.config.ts",
    "preview:stress": "vite preview --config stress/vite.config.ts",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:stress": "playwright test --config stress/playwright.config.ts",
    "generate:stress-level": "python3 scripts/generate-stress-level.py",
    "make:icon": "node scripts/make-icon.mjs",
    "dev:desktop": "concurrently -k -n vite,electron -c blue,magenta \"vite\" \"npm:dev:electron:wait\"",
    "dev:electron": "tsc -p electron/tsconfig.json && VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev:electron:wait": "node scripts/wait-for-url.mjs http://localhost:5173 && npm run dev:electron",
    "build:desktop": "npm run build && tsc -p electron/tsconfig.json && electron-builder --dir",
    "dist": "npm run build && tsc -p electron/tsconfig.json && electron-builder",
    "dist:win": "npm run build && tsc -p electron/tsconfig.json && electron-builder --win",
    "dist:mac": "npm run build && tsc -p electron/tsconfig.json && electron-builder --mac",
    "dist:linux": "npm run build && tsc -p electron/tsconfig.json && electron-builder --linux",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "lint": "eslint src --ext ts,tsx",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "verify": "npm run build && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@webgamedevkit/audio-engine": "^0.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.7",
    "koota": "^0.6.6",
    "lucide-react": "^0.562.0",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.21",
    "react-router-dom": "^7.13.1",
    "shadcn": "^3.6.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.183.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.22.4",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@csstools/postcss-oklab-function": "^4.0.12",
    "@playwright/test": "^1.58.2",
    "@react-three/test-renderer": "^9.1.1",
    "@types/node": "^25.0.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.16",
    "concurrently": "^10.0.6",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "postcss": "^8.4.32",
    "prettier": "^3.2.5",
    "sharp": "^0.35.5",
    "typescript": "^5.3.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.layercontainment.game",
    "productName": "Layer Containment",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/dist/**/*",
      "electron/package.json"
    ],
    "icon": "build/icon.png",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.games"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
